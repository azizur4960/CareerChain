# CareerChain Backend Environment Configuration
PROJECT_NAME="CareerChain"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Tokens
SECRET_KEY="careerchain-super-secret-key-change-this-in-production-diu-2025"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# If MySQL connection fails, backend automatically falls back to SQLite (sqlite:///./careerchain.db)
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/careerchain_db"
SQLITE_FALLBACK_URL="sqlite:///./careerchain.db"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Optional External AI API Key (Groq / OpenAI / Gemini) - local RAG runs automatically without this!
LLM_API_KEY=""
LLM_PROVIDER="local"
